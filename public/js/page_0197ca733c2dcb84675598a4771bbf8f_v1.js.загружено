$(function () {
    var timeOut;

    $('input[type="search"]', '#searchHeader').on(
        'focus',
        function () {
            $(this).removeClass('done');
        }
    );

    $('input[type="search"]', '#searchHeader').on(
        'change paste keyup',
        function () {

            var field = $(this).parent('.field'),
                query = $(this).val();

            field.addClass('progress').removeClass('found').removeClass('done');

            clearTimeout(timeOut);

            timeOut = setTimeout(
                function () {

                    if (query.length > 1) {

                        $.ajax(
                            {
                                url: '/local/templates/smorodinacosmetic_f61/ajax/search.php',
                                data: {
                                    'AJAX': 'Y',
                                    'COMPONENT': 'AJAX_CATALOG_SEARCH',
                                    'QUERY': query
                                },
                                success: function (data) {

                                    field.removeClass('progress');

                                    if (data.length > 0) {
                                        field.addClass('found');
                                    } else {
                                        field.addClass('none');
                                    }

                                    if (data.length > 0 && data !== 'null') {
                                        $('#searchHeaderResults').html(data).slideDown();
                                    }

                                }
                            }
                        );

                    } else {

                        $('#searchHeaderResults').html('');

                        field.removeClass('progress');

                    }

                },
                500
            );


        }
    );

});

