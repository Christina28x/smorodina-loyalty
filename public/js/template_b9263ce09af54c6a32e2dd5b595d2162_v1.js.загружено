jQuery(function ($) {

    const iterateDelay = 15000; // 15000 первое появление попапа через 30 сек, каждые последующие через 2 мин после первого
    

    function showPopups() {
        setTimeout(
            function () {
                showOnePopup('popup-magic');
            },
            (1 + 1) * 1 * iterateDelay // (index + 1) * 2 * iterateDelay
        );
    }

    function showOnePopup(popupName) {
        $('[data-name="'+ popupName +'"]').fadeIn(200);

        // метрика: Попап показан
        if (typeof ym != 'undefined') {
            ym('76511557', 'reachGoal', popupName + '_show');
        }
    }


    //showPopups();


    // повторное появление через 5 мин
    function resetCookie() {
        setTimeout(
            function () {
                $.cookie('SMORODINA_MARCH', null);
            },
            300000
        );
    }


    if ($.cookie('SMORODINA_MARCH') != "1") {
        //показать попап
        showPopups();
        $.cookie('SMORODINA_MARCH', "1", {  path: '/' });
        // сбросить куки для повторного показа
        //resetCookie();
    }


    $( ".popup__close").on('click', function () {
        //console.log($(this).parents('.popup-gift__wrapper').data("name"));
        $.cookie('SMORODINA_MARCH', "1", {  path: '/' });
        $(this).parents('.popup-gift__wrapper').fadeOut(200);

        // метрика: Попап закрыт
        if (typeof ym != 'undefined') {
            ym('76511557', 'reachGoal', $(this).parents('.popup-gift__wrapper').data("name") + '_close');
