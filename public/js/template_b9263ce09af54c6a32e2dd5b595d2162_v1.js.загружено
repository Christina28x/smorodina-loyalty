function addToCart(id, quantity = 1, productItem) {
    if (productItem == undefined) productItem = false;
    // console.log('id= ' + id + ' quantity= ' + quantity + ' productItem= ' + productItem);
    $.ajax(parent.location.pathname, {
        method: 'POST',
        dataType: 'json',
        data: {
            action: 'ADD2BASKET',
            id: id,
            ajax_basket: 'Y',
            quantity: quantity,
            prop: [],
        },
        success: function (data) {
            if (data.STATUS === 'OK') {
                headerCartUpdate();
                // console.log(quantity);
                // console.log(data);
                showBasketPopup(quantity, productItem, id);

                if (typeof gtag != "undefined") {
                    gtag('event', 'conversion', {
                        'send_to': 'AW-337173162/XJSvCLj08uICEKq146AB',
                        'value': productItem.data('product-price'),
                        'currency': 'RUB'
                    });
                }

                // метрика - добавление товара
                if (typeof ym != "undefined") {
                    ym('76511557', 'reachGoal', 'shop_addtocart_click');

                    window.dataLayer = window.dataLayer || [];
                    dataLayer.push(
                        {
                            "ecommerce": {
                                "add": {
                                    "products": [
                                        {
                                            'id': id,
                                            'name': productItem.data('product-name'),
                                            'category': productItem.data('product-category'),
                                            'price': productItem.data('product-price'),
                                            'brand': 'SmoRodina',
                                            'quantity': quantity
                                        }
                                    ]
                                }
                            }
                        }
                    );

                }

                if (typeof fbq == 'function') {

                    fbq(
                        'track',
                        'AddToCart',
                        {
                            value: parseFloat(productItem.data('product-price')),
                            currency: 'RUB',
                            content_name: productItem.data('product-name'),
                            content_ids: id,
                            content_type: 'product',
                        }
                    );
                }
            }
        },
    });
}


