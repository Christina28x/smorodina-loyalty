$(function () {

    /* main menu */

    $('.header__menu-icon').click(function () {
        $(this).toggleClass('header__menu-icon_active');
        $('.mega-menu').toggleClass('d-none');

        // Бургер-меню - открытие
        if (typeof ym != 'undefined') {
            ym('76511557', 'reachGoal', 'header_burger_click');
        }
    });

    if ($(window).width() < 992) {

        $('.mega-menu__menu__get-lvl2').click(function () {
            $(this).closest('li').find('ul').toggle();
            $(this).closest('li').find('.mega-menu__menu__get-lvl2_with-arrow').toggleClass('mega-menu__menu__get-lvl2_with-arrow_act');

            return false;
        })

    } else {

        $('.mega-menu__menu__get-lvl2, .get-lvl2__title_static').hover(function () {
            $('.mega-menu ul').addClass('mega-menu__opened-items');
            $('.mega-menu__menu__get-lvl2 ul').hide();
            $('.mega-menu__menu__active-item').removeClass('mega-menu__menu__active-item');

            // мой
            $('.mega-menu__menu__get-lvl2').removeClass('mega-menu__menu__active-item').closest('li').find('ul').hide();
            //

            $(this).addClass('mega-menu__menu__active-item').closest('li').find('ul').show();
            $('.mega-menu .mega-menu__banners').removeClass('d-none');
            $('.mega-menu .mega-menu__products').addClass('d-none');

            return false;
        })

    }



    $('.mega-menu__menu__get-products').hover(function () {
        $('.mega-menu .mega-menu__banners').addClass('d-none');
        $('.mega-menu .mega-menu__products').removeClass('d-none');

        // мой
        $('.mega-menu .mega-menu__products').closest('ul').removeClass('mega-menu__opened-items').hide();
        $('.mega-menu__menu__get-products').removeClass('mega-menu__menu__active-item');
        //


        $(this).closest('ul').addClass('mega-menu__opened-items');
        $(this).addClass('mega-menu__menu__active-item');

        return false;
    })

    /* hero */

    new Swiper('.hero__slides', {
        loop: true,
        effect: 'fade',
        autoplay: {
            delay: 5000,
            disableOnInteraction: false,
        },
        pagination: {
            el: '.hero__slides .swiper-pagination',
            clickable: true,
        }
    })

    /* rich slider */

    new Swiper('.rich-slider__slides', {
        loop: true,
        effect: 'fade',
        autoplay: {
            delay: 5000,
            disableOnInteraction: false,
        },
        pagination: {
            el: '.rich-slider__slides .swiper-pagination',
            clickable: true,
        },
        navigation: {
            nextEl: '.rich-slider__slides__next',
            prevEl: '.rich-slider__slides__prev',
        }
    })

    /* main recommends */

    const mainRecommendsSlides = new Swiper('.main-recommends__slides', {
        breakpoints: {
            0: {
                slidesPerView: 'auto',
                spaceBetween: 10,
            },
            320: {
                slidesPerView: 2.2,
                spaceBetween: 10,
            },
            // when window width is >= 480px
            900: {
                slidesPerView: 3.2,
                spaceBetween: 10,
            },
            992: {
                slidesPerView: 4,
                spaceBetween: 20
            }
        },
        navigation: {
            nextEl: '.main-recommends__slides .main-research__slides__next',
            prevEl: '.main-recommends__slides .main-research__slides__prev',
        },

    })

    $('.main-recommends__head__item').click(function () {
        let filter = $(this).attr('data-filter');

        $('.main-recommends .swiper-slide').hide();
        $('.main-recommends .swiper-slide[data-filter="' + filter + '"]').show();
        $('.main-recommends__head__item').removeClass('main-recommends__head__item_active');
        $(this).addClass('main-recommends__head__item_active');

        mainRecommendsSlides.updateSize();
        mainRecommendsSlides.updateSlides();
        mainRecommendsSlides.updateProgress();
        mainRecommendsSlides.updateSlidesClasses();
        mainRecommendsSlides.slideTo(0);
        mainRecommendsSlides.scrollbar.updateSize();

        return false;
    })

    /* main about */

    if ($('.main-about').length) {

        let mainAboutTextController = new ScrollMagic.Controller();
        new ScrollMagic.Scene({
            triggerElement: '.main-about'
        })
            .setTween('.main-about__text', {top: 100})
            .setClassToggle('.main-about__text', 'main-about__text_white')
            .addTo(mainAboutTextController)

        let mainAboutImgController = new ScrollMagic.Controller();
        const mainAboutImg = new ScrollMagic.Scene({
            triggerElement: '.main-about', duration: 600
        })
            .setTween('.main-about__video', {scale: 3.5})
            .addTo(mainAboutImgController)

        // доп для кнопки
        let mainAboutBtnController = new ScrollMagic.Controller();
        new ScrollMagic.Scene({
            triggerElement: '.main-about'
        })
            .setTween('.main-about__btn', {top: 80})
            .setClassToggle( ".main-about__btn" , "main-about__btn_act")
            .addTo(mainAboutBtnController)

    }


    /* product card */

    $(document).on('click', '.product-card__favorite', function () {

        let action;
        let id = $(this).closest('.product-card').attr('data-id');

        if ($(this).hasClass('product-card__favorite_active')) {
            action = 'delete';
            $(this).removeClass('product-card__favorite_active');
        } else {
            action = 'add';
            $(this).addClass('product-card__favorite_active');
        }

        var postData = {
            'sessid': BX.bitrix_sessid(),
            'site_id': BX.message('SITE_ID'),
            'id': id,
            'action': action
        };
        BX.ajax({
            url: '/local/templates/smorodinacosmetic_f61/ajax/favorites.php',
            method: 'POST',
            data: postData,
            dataType: 'json',
            onsuccess: function(result){
                //ShowCountFavorites(result);
            }
        });
    });


    $(document).on('click', '.product-card__btn-js', function () {
        // $('.product-card__text').removeClass('product-card__text_active');
        // $('.product-card__add-block').removeClass('product-card__add-block_active');
        // $('.product-card__count').removeClass('product-card__count_active');

        const textBlock = $(this).closest('.product-card').find('.product-card__text');
        const countBlock = $(this).closest('.product-card').find('.product-card__count__value');
        const countBlockSub = $(this).closest('.product-card').find('.product-card__text__price-quantity');
        let curCount = countBlock.html();

        if (Number(curCount) === 0) {
            countBlock.html(1);
            countBlockSub.html('x' + 1);
        }

        textBlock.addClass('product-card__text_active');
        $(this).closest('.product-card__add-block').addClass('product-card__add-block_active');
        $(this).closest('.product-card').find('.product-card__count').addClass('product-card__count_active');


        //if (Number(curCount) > 0) {
            $(this).addClass('add_to_cart');

            let item = $(this).closest('.item'),
                productItem = $(this),
                quantity = Number( $(this).parent().find('.product-card__count__value').html() );

            addToCart(item.data('id'), quantity, productItem);
            $(this).find('.product-card__btn .product-card__btn-text').html('В корзине');

        //}

        $('.product-card__btn-js').removeClass('add_to_cart');

    })

    $(document).on("click",".product-card__count__minus, .product-card__count__plus",function() {
    //$('.product-card__count__minus, .product-card__count__plus').click(function () {
        const addBlock = $(this).closest('.product-card__add-block'),
            textBlock = $(this).closest('.product-card').find('.product-card__text'),
            countBlock = $(this).closest('.product-card__count'),
            countBlockSub = $(this).closest('.product-card').find('.product-card__text__price-quantity'),
            countValueBlock = $(this).closest('.product-card__count').find('.product-card__count__value'),
            btnType = $(this).attr('data-type'),
            currencySymbol = $(this).parents('.product-card').find('.product-card__text__price').attr('data-currency-symbol'),
            curPrice =  $(this).parents('.product-card').find('.product-card__text__price-current').attr('data-current-price'),
            oldPrice = $(this).parents('.product-card').find('.product-card__text__price-old').attr('data-old-price');

        let curCount = countValueBlock.html();

        if (btnType === 'minus' && Number(curCount) > 0) {
            countValueBlock.html(Number(curCount) - 1);
            countBlockSub.html('x' + (Number(curCount) - 1));

            if (curPrice) {
                if (curCount <= 1) curCount = 2
                $(this).parents('.product-card').find('.product-card__text__price-current').html( (curPrice * (Number(curCount) - 1)).toLocaleString() + ' ' + currencySymbol );
            }
            if (oldPrice) {
                if (curCount <= 1) curCount = 2
                $(this).parents('.product-card').find('.product-card__text__price-old').html( (oldPrice * (Number(curCount) - 1)).toLocaleString() + ' ' + currencySymbol);
            }

        } else {
            countValueBlock.html(Number(curCount) + 1);
            countBlockSub.html('x' + (Number(curCount) + 1));

            if (curPrice) {
                $(this).parents('.product-card').find('.product-card__text__price-current').html( (curPrice * (Number(curCount) + 1)).toLocaleString() + ' ' + currencySymbol);
            }
            if (oldPrice) {
                $(this).parents('.product-card').find('.product-card__text__price-old').html( (oldPrice * (Number(curCount) + 1)).toLocaleString() + ' ' + currencySymbol);
            }
        }

        if (Number(countValueBlock.html()) === 0) {
            textBlock.removeClass('product-card__text_active');
            addBlock.removeClass('product-card__add-block_active');
            countBlock.removeClass('product-card__count_active');
            $('.product-card__btn-js').removeClass('add_to_cart');
        } else {
            textBlock.addClass('product-card__text_active');
            addBlock.addClass('product-card__add-block_active');
            countBlock.addClass('product-card__count_active');
        }
    })

    /* main research */

    let mainResearchSlidesInit = false,
        mainResearchSlides;

    function mainResearchSlider() {
        if (window.innerWidth >= 768) {
            if (!mainResearchSlidesInit) {
                mainResearchSlidesInit = true;
                mainResearchSlides = new Swiper('.main-research__slides', {
                    navigation: {
                        nextEl: '.main-research .main-research__slides__next',
                        prevEl: '.main-research .main-research__slides__prev',
                    },
                    slidesPerView: 4,
                    spaceBetween: 20
                })
            }
        } else if (mainResearchSlidesInit) {
            mainResearchSlides.destroy()
            mainResearchSlidesInit = false;
        }
    }

    if ($('.main-research__slides').length) {
        mainResearchSlider()
        window.addEventListener('resize', mainResearchSlider)
    }

    /* main awards */


    if ($('.main-awards').length) {

        let mainAwardsController = new ScrollMagic.Controller();
        const mainAwards = new ScrollMagic.Scene({
            triggerElement: '.main-awards'
        })
            .setClassToggle('.main-awards__icons', 'main-awards__icons_active')
            .addTo(mainAwardsController)

    }

    const awardsSlider = new Swiper('.main-awards__slides', {
        loop: true,
