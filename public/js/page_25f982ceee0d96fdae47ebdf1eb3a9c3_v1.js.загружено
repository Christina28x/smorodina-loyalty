function gtag_report_conversion(url) {
    var callback = function () {
        if (typeof(url) != 'undefined') {
            window.location = url;
        }
    };
    gtag('event', 'conversion', {
        'send_to': 'AW-337173162/VLZFCIjR8eICEKq146AB',
        'event_callback': callback
    });
    return false;
}

function validationRequisites() {
    return $(".necessarily").each(function () {
        if (0 == $(this).val()) {
            $(this).addClass("empty_val");
        } else {
            $(this).removeClass("empty_val");
        }
    }), !$("input").hasClass("empty_val") || alertPopup("Заполните все указанные поля!");
}
